# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project URL and public (anon) key - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key - server only, bypasses row level security
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site
NEXT_PUBLIC_SITE_URL=
